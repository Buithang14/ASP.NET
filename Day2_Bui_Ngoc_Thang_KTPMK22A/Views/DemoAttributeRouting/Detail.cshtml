@{
    ViewData["Title"] = "Chi tiết - Attribute Routing";
}

<div class="container py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="DemoConcepts" asp-action="Index">Trang chủ Demo</a></li>
            <li class="breadcrumb-item"><a href="/hoc-attribute-routing">Attribute Routing</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
        </ol>
    </nav>

    <div class="card border-primary shadow-sm mb-4">
        <div class="card-header bg-primary text-white fw-bold">
            Chi tiết môn học (Truyền tham số qua Attribute Route)
        </div>
        <div class="card-body">
            <p><strong>URL đã gọi:</strong> <code>@ViewBag.CurrentUrl</code></p>
            <div class="bg-dark text-light p-3 rounded mb-3">
                <small class="text-info">// Ràng buộc tham số kiểu int (:int) ngay trên Route:</small>
                <pre class="text-light mb-0"><code>[HttpGet("chi-tiet-mon-hoc/{id:int}")]
public IActionResult Detail(int id, string? name) { ... }</code></pre>
            </div>

            <ul class="list-group mb-3">
                <li class="list-group-item d-flex justify-content-between">
                    <span>Mã ID nhận từ Route:</span>
                    <strong class="text-primary">@ViewBag.Id</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>Tên môn học (Query string):</span>
                    <strong class="text-success">@ViewBag.SubjectName</strong>
                </li>
            </ul>
        </div>
    </div>

    <div>
        <a href="/hoc-attribute-routing" class="btn btn-secondary">&larr; Quay lại trang Attribute Routing</a>
    </div>
</div>
