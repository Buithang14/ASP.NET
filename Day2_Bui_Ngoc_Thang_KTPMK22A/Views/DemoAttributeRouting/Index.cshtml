@{
    ViewData["Title"] = "Demo Attribute Routing";
}

<div class="container py-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="DemoConcepts" asp-action="Index">Trang chủ Demo</a></li>
            <li class="breadcrumb-item active" aria-current="page">Attribute Routing</li>
        </ol>
    </nav>

    <div class="card border-primary shadow-sm mb-4">
